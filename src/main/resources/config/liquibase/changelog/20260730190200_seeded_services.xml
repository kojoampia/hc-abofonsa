    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        contextFilter="!test" — the content seeds do not load in the test context.

        JHipster's generated entity ITs assume they own an empty table. CarePlanTeaser.code and
        PledgeTierTeaser.code are unique enums with exactly three values each, and the seed occupies
        all of them, so a generated test that hardcodes code=BRONZE could never insert. Tests should
        not be reading production seed rows in any case; the ones that need content create their own.

        The index changelog deliberately has no filter — schema applies everywhere.
    -->

    <!--
        The six care services, copied from hc-abofonsa-web's V004SeedServices so the preview site
        and the main site describe the same offering in the same words. English only: the preview
        page localises its own chrome, but service copy has one source of truth and it is over
        there. Slugs match, so the two can be reconciled later without a mapping table.
    -->

