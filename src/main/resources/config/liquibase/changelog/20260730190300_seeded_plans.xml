    <!--
        contextFilter="!test" — the content seeds do not load in the test context.

        JHipster's generated entity ITs assume they own an empty table. CarePlanTeaser.code and
        PledgeTierTeaser.code are unique enums with exactly three values each, and the seed occupies
        all of them, so a generated test that hardcodes code=BRONZE could never insert. Tests should
        not be reading production seed rows in any case; the ones that need content create their own.

        The index changelog deliberately has no filter — schema applies everywhere.
    -->

    <!--
        PEAR / PAWPAW / MELON at the prices hc-abofonsa-web quotes (V005SeedPlans). The preview
        page teases these; the main site remains the place they are actually explained and sold,
        which is why only the headline feature list is carried over and not the full comparison
        matrix.
    -->

    <changeSet id="20260730190300-1" author="abofonsa" contextFilter="!test">
        <insert tableName="care_plan_teaser">
            <column name="id" valueNumeric="200"/>
            <column name="code" value="PEAR"/>
            <column name="name" value="PEAR Plan"/>
            <column name="for_who" value="A dependable weekday routine for a relative who is broadly well but should not be alone."/>
            <column name="price_amount" valueNumeric="3000.00"/>
            <column name="price_currency" value="GHS"/>
            <column name="price_period" value="MONTH"/>
            <column name="price_note" value="Minimum three-month term · 30 days' notice"/>
            <column name="featured" valueBoolean="false"/>
            <column name="display_order" valueNumeric="1"/>
            <column name="published" valueBoolean="true"/>
