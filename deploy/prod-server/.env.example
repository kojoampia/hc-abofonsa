# Template for ~/webroot/01-healthconnect/abofonsa-preview/.env on webserver.
#
# Copy to `.env`, fill in every generated value, and `chmod 600` it — it holds the database password
# and the signing key for every admin session. It is never committed; only this template is.
#
# `deploy.sh --bootstrap` generates all four secrets with `openssl rand` running ON THE SERVER, so
# they never exist on the deploying machine, in its shell history, or on the wire. Filling this in
# by hand is the fallback, not the normal path.
#
# Generate them fresh per environment. Do not reuse a value from staging, and do not reuse anything
# that has ever appeared in a chat log or a terminal history that syncs.

# --- Image ---------------------------------------------------------------------------------------

# TAG is set by deploy.sh to the deployed commit SHA. `latest` is a convenience for a manual deploy
# and should not be what production normally runs on, because it makes "what is deployed"
# unanswerable after the fact.
#
# REGISTRY is the deployment channel, and deploy.sh rewrites this line to match `--channel`:
#
#   docker.jojoaddison.net   the private registry; images built locally by deploy/build.sh
#   ghcr.io/<owner>          images built by .github/workflows/publish.yml on a GitHub runner
#
# It is a namespace, not a bare host, because that is how GHCR addresses images. compose.yml
# interpolates "${REGISTRY}/abofonsa-preview:${TAG}" either way. A GHCR package is private by
# default, so unless it has been made public the server needs `docker login ghcr.io` with a PAT
# carrying read:packages, or `./start` fails at the pull.
REGISTRY=docker.jojoaddison.net
TAG=latest

# --- Secrets (all four are required; the app refuses to start without them) -----------------------

# Postgres superuser password for this stack's database.
#   openssl rand -base64 24
POSTGRES_PASSWORD=

# JWT signing key. HS512 needs at least 64 bytes of key material.
#   openssl rand -base64 64 | tr -d '\n'
# Rotating this invalidates every issued token, which signs the operator out. That is the correct
# response to a suspected leak.
#
# There is no fallback if this is unset: the sample key lives in the `secret-samples` profile, which
# belongs to the *dev* profile group and is committed to the repository. Production must supply its
# own or fail to start, and failing to start is the safe outcome.
JWT_BASE64_SECRET=

# The admin password, applied to the seeded account at every boot. Unset, the account keeps
# generator-jhipster's committed `admin`/`admin`.
#   openssl rand -base64 24
ABOFONSA_ADMIN_PASSWORD=

# Salts the visitor and IP hashes stored in capture_event and waitlist_signup.
#   openssl rand -base64 32
# Unsalted, the whole IPv4 space can be hashed in minutes and the stored hashes reverse to
# addresses. Changing it resets every rate-limit counter and breaks UNIQUE_VISITORS continuity
# across the change — set it once, then leave it alone.
ABOFONSA_HASH_SALT=

# --- Public identity ------------------------------------------------------------------------------

# The address the public actually reaches. Emailed opt-in and unsubscribe links are built from it,
# and the confirm/unsubscribe endpoints redirect back to it, so a wrong value here sends people a
# link to a host that does not exist for them.
PUBLIC_URL=https://abofonsa.com

# Loopback port the app container publishes; nginx proxies to it. Change only if it collides with
# another app on this host — 8080 and 8081 are taken, and hc-abofonsa-web took 8082.
APP_PORT=8084

# Waitlist submissions per client per hour before the endpoint answers 429.
WAITLIST_MAX_PER_HOUR=5

# --- Mail (optional, but the waitlist is not much use without it) ----------------------------------

# Leave SMTP_HOST empty to run without mail: confirmation links are written to the application log
# instead of sent, and the double opt-in flow still completes end to end. Fine for a first deploy;
# not fine for a live waitlist, because nobody outside the server can complete their own signup.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
MAIL_FROM=noreply@abofonsa.com
